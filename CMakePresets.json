{
    "version": 6,
    "configurePresets": [
        {
            "name": "macos-arm64-debug",
            "displayName": "macOS ARM64 Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "architecture": {
                "value": "arm64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "macos-arm64-debug"
        }
    ]
}